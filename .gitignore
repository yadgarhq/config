# `helm package` output and fetched subcharts. Neither is produced by anything
# here today — Argo renders the chart from git — but both land in the working
# tree the moment somebody runs helm by hand.
*.tgz
chart/charts/

# Python bytecode, which `scripts/tests/` produces the first time it runs. The
# gate and its suite are the only Python here and neither is packaged.
__pycache__/
*.pyc

# Scratch PR-body files agents write while reviewing. Ignored here, in the
# repository, instead of relying on a contributor's machine-wide git config —
# that cover exists on one machine and reaches no other clone, no CI, and no
# other contributor.
.local-review/
